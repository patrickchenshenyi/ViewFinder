# ==============================================================================
# ViewFinder 配置模板
# ==============================================================================
# 用法：
#   cp .env.example .env && chmod 600 .env
#   然后把 <...> 占位符填成真值。
#
# ⚠️ .env 已被 .gitignore 排除，**绝不要**提交。
# ⚠️ 格式说明：scripts/vf_env.sh 用 `sed -nE 's/^[[:space:]]*KEY[[:space:]]*=[[:space:]]*//p'` 解析，
#    因此「key = value」与「key=value」都支持，但 **key 里不能有空格**，值不要加引号。
# ==============================================================================


# ------------------------------------------------------------------ 云实例 SSH
# 用于 scripts/vf_env.sh（所有 vf_*.sh 的公共环境），以及 ssh/scp。
# 在矩池云控制台可查到 host 与映射端口。
viewfinder_host = <云实例域名，形如 xxxx-xxx.matpool.com>
viewfinder_port = <云厂商映射的 SSH 端口，形如 2xxxx>
viewfinder_username = root
viewfinder_password = <云实例 SSH 密码>


# --------------------------------------------------------------- 手机 IP Webcam
# 手机开 IP Webcam、Start server 后显示的局域网地址（含端口）。
# 手机换网 / 重连后 IP 会变：改这里，然后重跑 `bash scripts/vf_up.sh` 重启反向隧道。
ip_webcam_lan_ip = <手机LAN IP:端口，例如 192.168.1.23:8080>


# ------------------------------------------------------------------ 矩池云控制台
# 仅用于人工登录云厂商 Web 控制台（开关机、存镜像、查端口）。
# 当前仓库内没有脚本读取这两项，可留空。
id = <矩池云登录邮箱>
pw = <矩池云登录密码>


# ------------------------------------------------------------------ DeepSeek API
# 两种命名都要注意，它们用在不同地方：
#
#  (1) 云端 ~/m6/.env  —— 取景推荐流水线（M6.6）真正读取的那个
#      由 m6/framing_for_case.sh 第 25 行读取，再以 `--key` 传给 m6/vlm_score.py（Bearer 认证）。
#      ⚠️ 这个文件不随 scripts/vf_deploy.sh 同步，换实例后必须手工创建：
#         mkdir -p ~/m6 && printf 'DEEPSEEK_KEY=%s\n' '<key>' > ~/m6/.env && chmod 600 ~/m6/.env
#
#  (2) 本地 .env 里的这一项 —— 用于人工调试 / 手动调 API，仓库内无脚本读取
#
#  API 端点与模型名硬编码在 m6/vlm_score.py、m6/refine.py：
#      https://api.deepseek.com/chat/completions  ·  deepseek-v4-flash-vision-exp
DEEPSEEK_KEY = <sk-...>
deepseek-v4-flash-vision-exp_api_key = <sk-...>
