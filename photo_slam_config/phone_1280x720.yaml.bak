%YAML:1.0

#--------------------------------------------------------------------------------------------
# ViewFinder 手机相机配置（ORB-SLAM3 monocular）—— 横屏 1280x720 @ 10fps
# 对应 M3 实时流：IP Webcam 1280x720 → ffmpeg fps=10 抽帧 → TUM 序列
# 用法：
#   ./bin/tum_mono ./ORB-SLAM3/Vocabulary/ORBvoc.txt \
#       ./cfg/ORB_SLAM3/Monocular/TUM/phone_1280x720.yaml \
#       ./cfg/gaussian_mapper/Monocular/TUM/tum_mono.yaml \
#       <seq目录> <输出目录> no_viewer
#--------------------------------------------------------------------------------------------
File.version: "1.0"

Camera.type: "PinHole"

# 相机内参（单位：像素）。粗略起步值 fx=fy=1280，主点取图像中心。后续拿真实内参再替换。
Camera1.fx: 1280.0
Camera1.fy: 1280.0
Camera1.cx: 640.0
Camera1.cy: 360.0

# 畸变（OpenCV 径向+切向模型）。未知，先全填 0。
Camera1.k1: 0.0
Camera1.k2: 0.0
Camera1.p1: 0.0
Camera1.p2: 0.0
Camera1.k3: 0.0

# 帧率：必须与 ffmpeg 抽帧帧率、rgb.txt 时间戳步长一致（脚本 FPS=10）
Camera.fps: 10

# 颜色顺序（0: BGR, 1: RGB）。ffmpeg 抽出的 PNG 是 RGB。
Camera.RGB: 1

# 分辨率：必须与实际喂进去的帧一致（IP Webcam 1280x720 = ffmpeg 抽帧 = 此处）
Camera.width: 1280
Camera.height: 720

#--------------------------------------------------------------------------------------------
# ORB Parameters（保持默认）
#--------------------------------------------------------------------------------------------
ORBextractor.nFeatures: 2000
ORBextractor.scaleFactor: 1.2
ORBextractor.nLevels: 8
ORBextractor.iniThFAST: 20
ORBextractor.minThFAST: 7

#--------------------------------------------------------------------------------------------
# Viewer Parameters（headless 加 no_viewer 时忽略）
#--------------------------------------------------------------------------------------------
Viewer.KeyFrameSize: 0.05
Viewer.KeyFrameLineWidth: 1.0
Viewer.GraphLineWidth: 0.9
Viewer.PointSize: 2.0
Viewer.CameraSize: 0.08
Viewer.CameraLineWidth: 3.0
Viewer.ViewpointX: 0.0
Viewer.ViewpointY: -0.7
Viewer.ViewpointZ: -1.8
Viewer.ViewpointF: 500.0
